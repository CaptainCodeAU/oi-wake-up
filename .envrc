# oi-wake-up Node.js Environment

# Auto-switch Node version via nvm
if [[ -f ".nvmrc" ]] && command -v nvm &>/dev/null; then
    nvm use --silent 2>/dev/null || nvm use
fi

# Clear the "direnv: loading..." line
printf "\033[A\033[2K"

local _pkg_version
_pkg_version=$(jq -r '.version // "?"' package.json 2>/dev/null || echo "?")

echo ""
echo "┌───────────────────────────────────────────────────────────────────────┐"
echo -e "│                  \033[1;32m📦 oi-wake-up\033[0m \033[2mv${_pkg_version}\033[0m                              │"
echo "├───────────────────────────────────────────────────────────────────────┤"
echo "│"
echo -e "│  \033[1;36m⚡ Dev\033[0m"
echo "│  ────────────────────────────────────────────────────────────────"
echo -e "│     \033[3;33mpnpm test\033[0m                              # Run all tests"
echo -e "│     \033[3;33mpnpm test:watch\033[0m                        # Watch mode"
echo -e "│     \033[3;33mpnpm install -g .\033[0m                      # Install CLIs globally"
echo "│"
echo -e "│  \033[1;36m📡 oi-wake-up\033[0m  \033[2m(magic packet sender)\033[0m"
echo "│  ────────────────────────────────────────────────────────────────"
echo -e "│     \033[3;33moi-wake-up AA:BB:CC:DD:EE:FF\033[0m"
echo -e "│     \033[3;33moi-wake-up -i 192.168.1.255 AA:BB:CC:DD:EE:FF\033[0m"
echo -e "│     \033[3;33moi-wake-up -d 1000 MAC MAC MAC\033[0m         # Retry with delay"
echo -e "│     \033[3;33moi-wake-up --print-packet AA:BB:CC:DD:EE:FF\033[0m  # Hex dump"
echo "│"
echo -e "│  \033[1;36m🔍 oi-wake-verify\033[0m  \033[2m(wake + SSH + remediate + verify)\033[0m"
echo "│  ────────────────────────────────────────────────────────────────"
echo -e "│     \033[2mFull pipeline\033[0m"
echo -e "│     \033[3;33moi-wake-verify <host> --mac <mac> -r \"bash -lc '...'\" -V \"bash -lc '...'\"\033[0m"
echo "│"
echo -e "│     \033[2mWake only (no SSH, no remediate)\033[0m"
echo -e "│     \033[3;33moi-wake-verify <host> --mac <mac> --wake-only\033[0m"
echo "│"
echo -e "│     \033[2mForce remediation on an awake host\033[0m"
echo -e "│     \033[3;33moi-wake-verify <host> --mac <mac> --force -r \"bash -lc '...'\"\033[0m"
echo "│"
echo -e "│     \033[2mDry-run + JSON output\033[0m"
echo -e "│     \033[3;33moi-wake-verify <host> --mac <mac> --dry-run -v\033[0m"
echo -e "│     \033[3;33moi-wake-verify <host> --mac <mac> --json | jq .exit\033[0m"
echo "│"
echo -e "│  \033[1;36m😴 oi-wake-down\033[0m  \033[2m(remote sleep via SSH)\033[0m"
echo "│  ────────────────────────────────────────────────────────────────"
echo -e "│     \033[3;33moi-wake-down <host>\033[0m                     # Sleep + confirm"
echo -e "│     \033[3;33moi-wake-down <host> --no-confirm\033[0m        # Fire-and-forget"
echo -e "│     \033[3;33moi-wake-down <host> --command 'sudo systemctl suspend'\033[0m  # Linux"
echo -e "│     \033[3;33moi-wake-down <host> --dry-run -v\033[0m"
echo "│"
echo -e "│  \033[1;36m🔬 Debug\033[0m"
echo "│  ────────────────────────────────────────────────────────────────"
echo -e "│     \033[3;33mnode bin/cli.js <mac>\033[0m                   # Run without global install"
echo -e "│     \033[3;33mnode bin/verify.js --help\033[0m               # Run without global install"
echo -e "│     \033[3;33mnode bin/sleep.js --help\033[0m                # Run without global install"
echo -e "│     \033[3;33msudo tcpdump -i any -n udp port 9 -X\033[0m   # Inspect magic packets"
echo "│"
echo "│  ℹ️  Info:"
echo "│  ────────"
echo -e "│     Node:    \033[36m$(node --version 2>/dev/null || echo 'N/A')\033[0m"
echo -e "│     pnpm:    \033[36m$(pnpm --version 2>/dev/null || echo 'N/A')\033[0m"
echo -e "│     Version: \033[36mv${_pkg_version}\033[0m"
echo "│"
echo "│  🔗 Global Install Status:"
echo "│  ──────────────────────────"
if pnpm list --global 2>/dev/null | grep -q "oi-wake-up"; then
    echo -e "│     Status:  \033[32m✓ Installed globally\033[0m"
else
    echo -e "│     Status:  \033[33m✗ Not installed\033[0m  →  \033[3;33mpnpm install -g .\033[0m"
fi
echo "│"
echo "└───────────────────────────────────────────────────────────────────────┘"
echo ""
