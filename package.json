{
	"name": "oi-wake-up",
	"version": "1.5.0",
	"description": "Wake-on-LAN done right. No dependencies, just Node.js.",
	"type": "module",
	"main": "./src/index.js",
	"exports": {
		".": {
			"import": "./src/index.js"
		},
		"./verify": {
			"import": "./src/verify.js"
		},
		"./spawn": {
			"import": "./src/spawn.js"
		},
		"./sleep": {
			"import": "./src/sleep.js"
		}
	},
	"bin": {
		"oi-wake-up": "./bin/cli.js",
		"oi-wake-verify": "./bin/verify.js",
